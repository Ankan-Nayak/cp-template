int rec(int sum, int i) {
    if (level == n) return 1;
    // add cache check
    int ans = rec(level + 1, time, item); // not take
    if (time+t[level] <= x && item+1 <= k) {
        ans = min(ans, s[level]+rec(level+1, time+t[level], item+1)); // take
    }
    // save and return
    return dp[level][time][item];
}


// level 1 (taken---level)
int rec(int sum, int i) {
    if (i > n || sum > target) return 0;
    
    if (sum == target) return 1;
    if (dp[sum][i] != -1) return dp[sum][i];
    int ans = 0;
    
    ans |= rec(sum + a[i+1], i+1);
    ans |= rec(sum, i+1);
    return dp[sum][i] = ans;
}


