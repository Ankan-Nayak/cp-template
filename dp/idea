vector<int> res;

int rec(int idx, int left) {
    if (idx == n + 1) {
        if (left == 0) {
            for (auto x : res) {
                cout << x << ' ';
            }

            cout << endl;
            return 1;

        }
        return 0;
    }
    if (dp[idx][left] != -1) {
        return dp[idx][left];
    }
    int ans = 0;

    ans |= rec(idx + 1, left);
    if (left - a[idx] >= 0) {
        res.push_back(a[idx]);
        if (rec(idx + 1, left - a[idx])) {
            ans = 1;
        } 
        res.pop_back();
    }
    return dp[idx][left] = ans;

}


// path 2 - recommended
void reconstruct(int idx, int left) {
    if (idx == n + 1) return;

    // If we can take a[idx], and it leads to a solution
    if (left - a[idx] >= 0 &&
        rec(idx + 1, left - a[idx])) {

        res.push_back(a[idx]);
        reconstruct(idx + 1, left - a[idx]);

    } else {
        // Otherwise don't take a[idx]
        reconstruct(idx + 1, left);
    }
}


